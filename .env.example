# Environment variables for EpicPix Media
# Copy this file to .env.local and fill in your values

# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANT: Never expose this key to the browser!
# Use only in server-side code (API routes, Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# YouPI-PG Payment Gateway
# ===========================================
YOUPI_API_KEY=your_youpi_api_key
YOUPI_API_URL=https://api.youpi-pg.in/v1
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_secret

# ===========================================
# Resend (for emails)
# ===========================================
RESEND_API_KEY=your_resend_api_key

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EpicPix Media

# ===========================================
# Indian Number Formatting Config
# ===========================================
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_GST_RATE=0.18

# ===========================================
# Admin Configuration
# ===========================================
ADMIN_EMAILS=admin@epicpix.media,support@epicpix.media